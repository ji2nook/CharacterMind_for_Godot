[resource]
script = ExtResource("1_v5f2t")
entries = Array[String](["아스카 왕국은 호수 평원에 자리한 나라다.", "오크베일은 아스카 왕국 동쪽 끝에 위치한 한적한 시골 마을이다.", "오크베일 주민들은 매년 봄 풍요를 기원하는 하베스트 축제를 연다."])
